// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Analysis {
  id            String   @id @default(cuid())
  plantType     String
  diseaseName   String
  scientificName String?
  confidence    Int
  severity      String?
  category      String?
  isPlant       Boolean  @default(true)
  isHealthy     Boolean  @default(false)
  // Arrays stored as JSON strings (SQLite limitation)
  symptoms      String
  causes        String
  treatment     String
  prevention    String
  description   String?
  // Compressed base64 data URL of the analyzed image
  imageData     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
